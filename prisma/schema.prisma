generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  plan      String   @default("starter") // starter, pro, enterprise

  integrations  Integration[]
  automations   Automation[]
  automation_logs AutomationLog[]

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("users")
}

model Integration {
  id          String   @id @default(cuid())
  userId      String
  type        String   // shopify, amazon, ebay
  apiKey      String   @db.Text // Encrypted via Prisma encryption
  storeUrl    String?
  enabled     Boolean  @default(true)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  orders      Order[]
  automations Automation[]

  last_sync   DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([userId, type, storeUrl])
  @@map("integrations")
}

model Product {
  id              String   @id @default(cuid())
  integrationId   String
  externalId      String
  name            String
  sku             String?
  description     String?
  price           Decimal
  stock           Int
  imageUrl        String?

  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  orders          Order[]

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([integrationId, externalId])
  @@map("products")
}

model Order {
  id              String   @id @default(cuid())
  integrationId   String
  productId       String?
  externalId      String
  quantity        Int
  revenue         Decimal
  status          String   // pending, shipped, delivered, cancelled

  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  product         Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  order_date      DateTime
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([integrationId, externalId])
  @@map("orders")
}

model Analytics {
  id              String   @id @default(cuid())
  integrationId   String
  date            DateTime @unique

  total_revenue   Decimal
  total_orders    Int
  total_products  Int
  conversion_rate Decimal?
  avg_order_value Decimal?

  created_at      DateTime @default(now())

  @@map("analytics")
}

model Automation {
  id              String   @id @default(cuid())
  integrationId   String
  userId          String
  name            String
  type            String   // price_adjustment, stock_alert, description_update
  condition       Json
  action          Json
  enabled         Boolean  @default(true)
  frequency       String   // daily, real-time, on_order

  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            AutomationLog[]

  last_run        DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("automations")
}

model AutomationLog {
  id              String   @id @default(cuid())
  automationId    String
  userId          String
  status          String   // success, failed, skipped
  affected_items  Int
  details         Json?

  automation      Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  executed_at     DateTime @default(now())

  @@map("automation_logs")
}

model OAuthState {
  id              String   @id @default(cuid())
  state           String   @unique
  store_url       String
  user_id         String
  expires_at      DateTime
  created_at      DateTime @default(now())

  @@map("oauth_states")
}
